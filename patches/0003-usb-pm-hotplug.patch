+
+bool AirPortRTW::willTerminate(IOService *provider, IOOptionBits options)
+{
+#ifdef RTW_USB
+    /* Hot-unplug: make every later USB I/O fail immediately instead of timing out; the real teardown runs in stop(). */
+    if (_isUsb && _usbCore) {
+        IOLog("AirPortRTW: USB provider terminating (hot-unplug)\n");
+        rtl8188eu_core_mark_gone(_usbCore);
+        __atomic_store_n(&_dmaStopped, true, __ATOMIC_RELEASE);
+        _txStalled = true;
+    }
+#endif
+    return super::willTerminate(provider, options);
 }
 
+bool AirPortRTW::didTerminate(IOService *provider, IOOptionBits options, bool *defer)
+{
+#ifdef RTW_USB
+    /* The default implementation defers while we still have the provider open, so stop() never ran after a USB re-enumeration
+     * (observed after sleep/wake: old instance stuck "inactive, busy 1", new start() failed with -EBUSY). Close it here. */
+    if (_isUsb && _usbCore) {
+        IOLog("AirPortRTW: didTerminate: closing USB provider\n");
+        rtl8188eu_core_release_provider(_usbCore);
+    }
+#endif
+    return super::didTerminate(provider, options, defer);
+}
