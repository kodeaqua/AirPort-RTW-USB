+
+bool AirPortRTW::willTerminate(IOService *provider, IOOptionBits options)
+{
+#ifdef RTW_USB
+    /* Hot-unplug: make every later USB I/O fail immediately instead of timing out; the real teardown runs in stop(). */
+    if (_isUsb && _usbCore) {
+        IOLog("AirPortRTW: USB provider terminating (hot-unplug)\n");
+        rtl8188eu_core_mark_gone(_usbCore);
+        __atomic_store_n(&_dmaStopped, true, __ATOMIC_RELEASE);
+        _txStalled = true;
+    }
+#endif
+    return super::willTerminate(provider, options);
 }
 
