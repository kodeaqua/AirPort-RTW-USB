diff --git a/src/compat/rtw88_core_ops.h b/src/compat/rtw88_core_ops.h
new file mode 100644
index 0000000..c78f0f5
--- /dev/null
+++ b/src/compat/rtw88_core_ops.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * rtw88_core_ops.h - optional core dispatch table.
+ *
+ * When no table is registered (g_rtw88_core_ops == NULL, the PCIe default) every helper in
+ * rtw88_compat.c runs its original rtw88 body unchanged. A second core (e.g. the USB RTL8188EU
+ * core) registers a table; any non-NULL entry then replaces the matching helper. Entries left
+ * NULL fall through to the rtw88 body, so a core must fill every entry it needs.
+ */
+#ifndef RTW88_CORE_OPS_H
+#define RTW88_CORE_OPS_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ieee80211_hw;
+struct ieee80211_vif;
+struct rtw_dev;
+
+struct rtw88_core_ops {
+    const char *name;
+
+    /* lifecycle: replace rtw_pci_probe()/rtw_pci_remove() in RTW88IEEE80211::start()/stop().
+     * probe() must register its ieee80211_hw with rtw88_register_hw(). */
+    int  (*probe)(void *transport);
+    void (*remove)(void *transport);
+
+    /* link / scan helpers (original bodies deref rtw_dev) */
+    bool (*is_scanning)(void);
+    bool (*hw_scan_supported)(struct ieee80211_hw *hw);
+    void (*sw_scan_start)(struct ieee80211_hw *hw, struct ieee80211_vif *vif);
+    void (*sw_scan_switch_channel)(struct ieee80211_hw *hw);
+    void (*sw_scan_complete)(struct ieee80211_hw *hw, struct ieee80211_vif *vif);
+    int  (*restore_interface)(struct ieee80211_hw *hw, struct ieee80211_vif *vif);
+    int  (*set_station_mac)(struct ieee80211_hw *hw, struct ieee80211_vif *vif, const uint8_t *mac);
+    void (*connect_hw_setup)(struct ieee80211_hw *hw, struct ieee80211_vif *vif, const uint8_t *bssid);
+    void (*restore_connected_hw)(struct ieee80211_hw *hw, struct ieee80211_vif *vif, const uint8_t *bssid);
+    void (*restore_connected_hw_timeslice)(struct ieee80211_hw *hw, struct ieee80211_vif *vif, const uint8_t *bssid);
+    void (*force_wifi_only)(void);
+
+    /* info getters (rtwdev is opaque to the frontend) */
+    void    (*get_fw_version)(struct rtw_dev *dev, uint16_t *version, uint8_t *sub_version);
+    void    (*get_chip_name)(struct rtw_dev *dev, char *buf, size_t sz);
+    void    (*get_stats)(struct rtw_dev *dev, uint32_t *tx_bytes, uint32_t *rx_bytes);
+    uint8_t (*get_tx_nss)(struct rtw_dev *dev);
+
+    /* TX flow control (PCI: BE ring; USB: free async TX buffers) */
+    uint32_t (*tx_avail)(void);
+    int      (*tx_busy)(void);
+};
+
+extern const struct rtw88_core_ops *g_rtw88_core_ops;
+void rtw88_set_core_ops(const struct rtw88_core_ops *ops);
+
+/* True when ops is registered and the named entry is set. */
+#define RTW88_OPS(member) (g_rtw88_core_ops && g_rtw88_core_ops->member)
+
+#ifdef __cplusplus
+}
+#endif
+#endif
